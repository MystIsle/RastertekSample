# 저장소 내부는 LF로 정규화, 체크아웃 시 아래 규칙대로 변환

* text=auto

# Windows/Visual Studio 소스 — 작업 트리에서 CRLF
*.cpp      text eol=crlf
*.h        text eol=crlf
*.inl      text eol=crlf
*.hlsl     text eol=crlf
*.rc       text eol=crlf
*.sln      text eol=crlf
*.vcxproj* text eol=crlf

# 유닉스 계열 도구 — LF
*.sh           text eol=lf
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.md           text eol=lf
*.json         text eol=lf
*.xml          text eol=lf
